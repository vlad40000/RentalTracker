{
  "name": "rental-tracker-demo",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/migrate.mjs && node --experimental-strip-types scripts/seed.ts && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "verify": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.4.0",
    "fflate": "^0.8.2",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
