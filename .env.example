# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Dummy demo auth. Replace before any real deployment.
DEMO_AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=demo-only-change-me

# Vercel Cron request secret.
CRON_SECRET=replace-with-a-random-secret

# Automatically provided when Vercel Blob is connected.
BLOB_READ_WRITE_TOKEN=

# Enables sample-portfolio reset and visible demo labeling. Must be exactly "true".
DEMO_MODE=true

# Defaults to masked names. Set exactly "true" only for a controlled presentation, then reseed.
DEMO_SHOW_REAL_TENANT_NAMES=false
